{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File with Input",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": true,
            "redirectOutput": true,
            "args": [],
            // 从当前文件所在目录的 input.txt 读取输入
            "redirectInput": "${fileDirname}/input.txt"
        },
        {
            "name": "Python: Current File (No Input)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "justMyCode": true
        }
    ]
}